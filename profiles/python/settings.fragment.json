{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest *)",
      "Bash(uv run ruff check *)",
      "Bash(uv run ruff format --check *)",
      "Bash(uv run mypy *)",
      "Bash(uv sync *)",
      "Bash(pytest *)"
    ],
    "ask": [
      "Bash(uv run ruff check *--fix*)",
      "Bash(ruff check *--fix*)"
    ]
  }
}
