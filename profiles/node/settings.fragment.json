{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run lint *)",
      "Bash(npm run typecheck *)",
      "Bash(npm run build *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm build *)",
      "Bash(yarn test *)",
      "Bash(yarn lint *)",
      "Bash(npx --no-install tsc *)",
      "Bash(npx --no-install eslint *)",
      "Bash(npx --no-install prettier --check *)",
      "Bash(npx --no-install vitest run *)",
      "Bash(npx --no-install jest *)"
    ]
  }
}
